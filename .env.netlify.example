# ===========================================
# VARIABLES DE ENTORNO PARA NETLIFY
# ===========================================
# Copia estas variables al panel de Netlify:
# Site Settings > Environment Variables

# ===========================================
# BASE DE DATOS Y SUPABASE
# ===========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://user:pass@host:port/database

# ===========================================
# AUTENTICACIÓN Y SEGURIDAD
# ===========================================
JWT_SECRET=tu-jwt-secret-muy-seguro-minimo-32-caracteres
USER_JWT_SECRET=tu-user-jwt-secret-muy-seguro-minimo-32-caracteres
API_SECRET_KEY=tu-api-secret-key-muy-seguro-minimo-32-caracteres
SESSION_SECRET=tu-session-secret-muy-seguro-minimo-32-caracteres

# ===========================================
# APIs DE INTELIGENCIA ARTIFICIAL
# ===========================================
OPENAI_API_KEY=sk-tu-openai-api-key-aqui
GEMINI_API_KEY=tu-gemini-api-key-aqui
CHATBOT_MODEL=gpt-4o-mini
CHATBOT_MAX_TOKENS=1000
CHATBOT_TEMPERATURE=0.7
CHATBOT_NAME=LIA

# ===========================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail

# ===========================================
# GOOGLE OAUTH (OPCIONAL)
# ===========================================
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ===========================================
# CONFIGURACIÓN GENERAL
# ===========================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://tu-sitio.netlify.app
ALLOWED_ORIGINS=https://tu-sitio.netlify.app,https://tu-dominio-personalizado.com

# ===========================================
# INSTRUCCIONES:
# ===========================================
# 1. Ve a tu panel de Netlify
# 2. Site Settings > Environment Variables  
# 3. Agrega cada variable una por una
# 4. NO incluyas los comentarios (#)
# 5. Reemplaza todos los valores de ejemplo con los reales
# 6. Guarda y redespliega tu sitio