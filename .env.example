# =================================
# CONFIGURACIÓN DE BASE DE DATOS
# =================================

# Supabase Configuration (REQUERIDO)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct (Opcional - si no usas Supabase)
DATABASE_URL=postgresql://user:pass@host:port/database

# =================================
# CONFIGURACIÓN DE SEGURIDAD
# =================================

# JWT Secrets (REQUERIDO - usar valores únicos y seguros)
JWT_SECRET=tu-jwt-secret-key-muy-seguro-y-largo
USER_JWT_SECRET=tu-user-jwt-secret-key-muy-seguro-y-largo
API_SECRET_KEY=tu-api-secret-key-muy-seguro-y-largo

# =================================
# APIS DE INTELIGENCIA ARTIFICIAL
# =================================

# OpenAI (REQUERIDO)
OPENAI_API_KEY=sk-...
CHATBOT_MODEL=gpt-4o-mini
CHATBOT_MAX_TOKENS=1000
CHATBOT_TEMPERATURE=0.7
CHATBOT_NAME=LIA

# Google Gemini (Opcional)
GEMINI_API_KEY=AI...

# =================================
# CONFIGURACIÓN DEL SERVIDOR
# =================================

# Entorno (REQUERIDO)
NODE_ENV=production

# Puerto (para desarrollo local)
PORT=3000

# URLs permitidas (REQUERIDO para producción)
FRONTEND_URL=https://tu-sitio.netlify.app
ALLOWED_ORIGINS=https://tu-sitio.netlify.app,https://www.aprendeyaplica.ai

# =================================
# CONFIGURACIÓN DE EMAIL
# =================================

# SMTP Configuration (Recomendado para verificación de email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# =================================
# GOOGLE OAUTH (OPCIONAL)
# =================================

# Google OAuth para login social
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# =================================
# CONFIGURACIÓN ADICIONAL
# =================================

# Audio Configuration (Opcional)
AUDIO_ENABLED=true
AUDIO_VOLUME=0.7

# Session Configuration
SESSION_SECRET=tu-session-secret-muy-seguro

# =================================
# INSTRUCCIONES DE CONFIGURACIÓN
# =================================

# 1. Copia este archivo como .env
# 2. Reemplaza todos los valores de ejemplo con tus datos reales
# 3. NUNCA subas el archivo .env a git
# 4. Para Netlify, configura estas variables en:
#    Site Settings → Environment Variables
# 5. Las variables marcadas como REQUERIDO son necesarias
#    para que la aplicación funcione correctamente